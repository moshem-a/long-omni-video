# ---- Local development ----
# Set to 1 to bypass Firebase auth locally (uses a fixed dev user).
# In this mode the app uses GEMINI_API_KEY below instead of Firestore.
DEV_NO_AUTH=1
GEMINI_API_KEY=

PORT=9002

# ---- Cloud / production (not needed when DEV_NO_AUTH=1 without cloud) ----
# Cloud Storage bucket for source-video uploads (signed URLs).
GCS_BUCKET=

# AES-256 secret for encrypting users' Gemini keys at rest.
# Generate with: openssl rand -base64 32
KEY_ENC_SECRET=

# Public Firebase web config (from Firebase console -> Project settings -> Web app).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# For local dev WITH real Firebase/GCS, point at a service-account key:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
