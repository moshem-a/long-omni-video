# ---- Local development ----
# There is no login. In production each browser sends its own Gemini key per
# request (x-gemini-key). For local dev, set DEV_NO_AUTH=1 so requests without
# that header fall back to GEMINI_API_KEY below.
DEV_NO_AUTH=1
GEMINI_API_KEY=

PORT=9002

# ---- Cloud / production ----
# Cloud Storage bucket for source-video uploads (signed URLs).
GCS_BUCKET=

# For local dev WITH real GCS/Firestore, point at a service-account key:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
